# Settings for the API server (server/). Copy to .env.local and fill in.
# Never commit real values. These have no VITE_ prefix, so Vite never sends
# them to the browser.

# Connection string for YOUR MongoDB server (see mongodb/README.md).
# The username and password are the app account (MONGO_APP_USERNAME /
# MONGO_APP_PASSWORD in mongodb/.env), not the root account.
# authSource must be the app database, because that is where the user was created.
#
# Database on the same machine as the app:
MONGODB_URI=mongodb://dsw_app:change-me-app-password@127.0.0.1:27017/digital_skills_wallet?authSource=digital_skills_wallet
#
# Database on a separate server (private network address, with TLS enabled on mongod):
# MONGODB_URI=mongodb://dsw_app:<password>@10.0.0.5:27017/digital_skills_wallet?authSource=digital_skills_wallet&tls=true

# Port for the API server (Vite proxies /api here during development).
# API_PORT=4000

# Optional: connection pool size per app instance (default 10).
# MONGODB_MAX_POOL_SIZE=10

# Optional: password for the demo accounts created by `pnpm db:seed`.
# SEED_PASSWORD=ChangeMe-Demo-2026!

# Until login exists, teacher screens act as this teacher.
# DEMO_TEACHER_EMAIL=s.chen@northview.example

# Optional: Hyperledger Fabric (see fabric/README.md). The defaults work with
# `pnpm fabric:up` on the same machine.
# FABRIC_SCHOOL_PEER_ENDPOINT=localhost:7051
# FABRIC_KANAVOOGLE_PEER_ENDPOINT=localhost:9051
# FABRIC_ORGANIZATIONS_DIR=fabric/organizations

# Production only:
# ENABLE_LEDGER_DEMO=true   # serve the Blockchain Ledger screen's data (it has no login, so demos only)
# TRUST_PROXY=1             # behind nginx etc., so audit logs record the client's real IP
