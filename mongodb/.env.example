# MongoDB server settings, read by mongodb/docker-compose.yml.
# Copy to mongodb/.env and replace every "change-me" value.
# Generate strong passwords with:  openssl rand -hex 24
# (hex passwords need no URL-encoding in MONGODB_URI)

# Root/admin account. Use it for maintenance only.
MONGO_ROOT_USERNAME=dsw_admin
MONGO_ROOT_PASSWORD=change-me-root-password

# Account the Next.js app uses. It can only read and write MONGO_APP_DB.
# These must match the username and password in MONGODB_URI in the app's .env.local.
MONGO_APP_DB=digital_skills_wallet
MONGO_APP_USERNAME=dsw_app
MONGO_APP_PASSWORD=change-me-app-password

# Network exposure. 127.0.0.1 = only this machine can connect (recommended
# when the app and database share a server). To let a separate app server
# connect, set this to the database server's private IP and firewall the port.
MONGO_BIND_IP=127.0.0.1
MONGO_PORT=27017

# RAM (GB) MongoDB may use for its cache. Roughly 50% of the server's RAM minus 1 GB.
MONGO_CACHE_SIZE_GB=1
