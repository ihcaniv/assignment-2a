{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "server": "tsx watch server/index.ts",
    "dev:full": "concurrently -k -n api,web -c blue,magenta \"pnpm server\" \"pnpm dev\"",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p . && tsc -p server",
    "db:up": "docker compose -f mongodb/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f mongodb/docker-compose.yml down",
    "db:logs": "docker compose -f mongodb/docker-compose.yml logs -f mongodb",
    "db:shell": "docker compose -f mongodb/docker-compose.yml exec mongodb sh -c 'mongosh -u \"$MONGO_APP_USERNAME\" -p \"$MONGO_APP_PASSWORD\" --authenticationDatabase \"$MONGO_APP_DB\" \"$MONGO_APP_DB\"'",
    "db:seed": "tsx server/scripts/db-seed.ts",
    "db:indexes": "tsx server/scripts/db-indexes.ts",
    "db:backup": "bash mongodb/backup.sh",
    "fabric:up": "bash fabric/network.sh up",
    "fabric:down": "bash fabric/network.sh down",
    "fabric:status": "bash fabric/network.sh status",
    "fabric:clean": "bash fabric/network.sh clean",
    "ledger:sync": "tsx server/scripts/ledger-sync.ts",
    "ledger:demo": "tsx server/scripts/ledger-demo.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@hyperledger/fabric-gateway": "^1.13.0",
    "@hyperledger/fabric-protos": "^0.2.2",
    "express": "^5.3.0",
    "mongoose": "^9.11.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.5",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
